{
  "name": "@qoti/dev-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Node relay for development and e2e: RoomCore over WebSockets.",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@qoti/protocol": "*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
